# Test toggles for the vitest suite.
#
# NOTE: vitest reads `process.env` directly — Next.js auto-loads
# `.env` files, but vitest does NOT. Set these inline in your shell:
#
#   CI=1 npm test
#   NEXUS_DEBUG_STUBS=1 npm test
#   CI=1 NEXUS_DEBUG_STUBS=1 npm test
#
# These toggles are also documented in the dashboard README under
# "Tests (vitest) → Test toggles" so contributors don't have to grep
# `src/` to discover them.

# Re-enable the useNexusData.live-flow.sentinel.test.tsx suite
# locally. The sentinel is wrapped in
# `describe.runIf(Boolean(process.env.CI))` so it only runs in CI
# providers (GitHub Actions, Jenkins, GitLab CI, etc.) by default.
# Set CI=1 on a developer machine to reproduce CI-only failures or
# to run the sentinel alongside the regular suite.
CI=1

# Enable verbose stubFetch routing logs. When set, every fired fake
# fetch in src/test-utils/fetch-stub.ts emits:
#
#   [fetch-stub] stubFetch fired for <path>
#
# on stdout. Useful when a test sees empty or unexpected state and
# you need to confirm whether the stub actually routed for a given
# pathname.
NEXUS_DEBUG_STUBS=1
