intensity={0.5} />\n                    <ThreeDText \n                        text={title} \n                        subtitle={subtitle} \n                        primaryColor={primary_color} \n                    />\n                </ThreeCanvas>\n            </AbsoluteFill>\n\n            {/* CTA Overlay Layer */}\n            {showCtaNow && (\n                <Sequence from={durationInFrames - (fps * 2)}>\n                    <CTAOverlay type={cta_type || 'engagement'} text={cta_text || ''} />\n                </Sequence>\n            )}\n        </AbsoluteFill>\n    );\n};"
