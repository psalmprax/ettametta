\n                    <EffectComposer enableNormalPass={false}>\n                        <Bloom \n                            luminanceThreshold={0.2} \n                            luminanceSmoothing={0.9} \n                            intensity={2.0} \n                            mipmapBlur \n                        />\n                        <Glitch\n                            delay={new THREE.Vector2(1.5, 3.5)}\n                            duration={new THREE.Vector2(0.1, 0.3)}\n                            strength={new THREE.Vector2(0.1, 0.5)}\n                            mode={GlitchMode.SPORADIC}\n                            active={true}\n                            ratio={0.85}\n                        />\n                    </EffectComposer>\n                </ThreeCanvas>\n\n                {/* Typography Layer */}\n                <AbsoluteFill style={{ display: 'flex', justifyContent: 'center', alignItems: 'center', zIndex: 10, pointerEvents: 'none' }}>\n                    <h1 style={{\n                        color: 'white',\n                        fontSize: '120px',\n                        fontWeight: 900,\n                        fontFamily: 'monospace',\n                        letterSpacing: '5px',\n                        margin: 0,\n                        textTransform: 'uppercase',\n                        textAlign: 'center',\n                        textShadow: `0 0 20px ${primary_color}`\n                    }}>\n                        {title}\n                    </h1>\n                    <p style={{\n                        color: primary_color,\n                        fontSize: '40px',\n                        fontWeight: 400,\n                        fontFamily: 'monospace',\n                        letterSpacing: '10px',\n                        margin: '20px 0 0 0',\n                        textTransform: 'uppercase',\n                        textShadow: `0 0 10px ${primary_color}`\n                    }}>\n                    