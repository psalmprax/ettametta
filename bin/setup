#!/usr/bin/env bash
# ============================================================
# ettametta environment setup
# Creates Python venv and installs Node.js dependencies
# Usage: ./bin/setup [--python] [--node] [--all]
# ============================================================
set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
PROJECT_ROOT="$(dirname "$SCRIPT_DIR")"
VENV_DIR="$PROJECT_ROOT/.venv"
PYTHON_VERSION="${PYTHON_VERSION:-python3}"

RED='\033[0;31m'
GREEN='\033[0;32m'
YELLOW='\033[1;33m'
BLUE='\033[0;34m'
NC='\033[0m'

log()  { echo -e "${GREEN}[setup]${NC} $*"; }
warn() { echo -e "${YELLOW}[setup]${NC} $*"; }
err()  { echo -e "${RED}[setup]${NC} $*" >&2; }

usage() {
    cat <<EOF
Usage: $(basename "$0") [OPTIONS]

Setup ettametta development environment.

Options:
  --python       Setup Python virtual environment only
  --node         Install Node.js dependencies only
  --all          Setup everything (default)
  --docker       Build Docker images
  --clean-venv   Remove and recreate Python venv from scratch
  --help         Show this message

Environment variables:
  PYTHON_VERSION   Python binary to use (default: python3)
EOF
}

# --- Python Setup ---
setup_python() {
    log "Setting up Python environment..."

    if [ ! -d "$VENV_DIR" ]; then
        log "Creating virtual environment at $VENV_DIR"
        $PYTHON_VERSION -m venv "$VENV_DIR"
    fi

    source "$VENV_DIR/bin/activate"

    log "Upgrading pip..."
    pip install --upgrade pip setuptools wheel -q

    if [ -f "$PROJECT_ROOT/requirements.txt" ]; then
        log "Installing Python dependencies from requirements.txt..."
        # Install everything except gTTS first (gTTS requires click<8.2,
        # which conflicts with typer). Then install gTTS without deps.
        grep -v "^gTTS" "$PROJECT_ROOT/requirements.txt" | pip install -r /dev/stdin -q
        pip install gTTS --no-deps -q 2>/dev/null || true
    else
        err "requirements.txt not found!"
        exit 1
    fi

    log "Python setup complete. Activate with: source .venv/bin/activate"
}

# --- Clean + Recreate Python Venv ---
clean_venv() {
    log "Removing existing virtual environment..."
    rm -rf "$VENV_DIR"
    setup_python
}

# --- Node.js Setup ---
setup_node() {
    log "Setting up Node.js dependencies..."

    # Dashboard
    if [ -f "$PROJECT_ROOT/apps/dashboard/package.json" ]; then
        log "Installing dashboard dependencies..."
        (cd "$PROJECT_ROOT/apps/dashboard" && npm install --silent)
    fi

    # Remotion Studio
    if [ -f "$PROJECT_ROOT/apps/remotion-studio/package.json" ]; then
        log "Installing remotion-studio dependencies..."
        (cd "$PROJECT_ROOT/apps/remotion-studio" && npm install --silent)
    fi

    log "Node.js setup complete."
}

# --- Docker ---
setup_docker() {
    log "Building Docker images..."
    cd "$PROJECT_ROOT"
    docker compose build
    log "Docker build complete."
}

# --- Main ---
main() {
    local do_python=false
    local do_node=false
    local do_docker=false
    local clean=false

    if [ $# -eq 0 ]; then
        do_python=true
        do_node=true
    fi

    while [ $# -gt 0 ]; do
        case "$1" in
            --python)     do_python=true ;;
            --node)       do_node=true ;;
            --all)        do_python=true; do_node=true ;;
            --docker)     do_docker=true ;;
            --clean-venv) clean=true ;;
            --help|-h)    usage; exit 0 ;;
            *)            err "Unknown option: $1"; usage; exit 1 ;;
        esac
        shift
    done

    cd "$PROJECT_ROOT"

    if $clean; then
        clean_venv
    elif $do_python; then
        setup_python
    fi

    if $do_node; then
        setup_node
    fi

    if $do_docker; then
        setup_docker
    fi

    log "Setup complete!"
    echo ""
    echo -e "${BLUE}Quick start:${NC}"
    echo "  source .venv/bin/activate"
    echo "  uvicorn src.api.main:app --reload"
    echo "  cd apps/dashboard && npm run dev"
}

main "$@"
